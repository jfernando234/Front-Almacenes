# ---------------------------------------------
# Node modules
# ---------------------------------------------
/node_modules/
/.angular

# ---------------------------------------------
# Angular build output
# ---------------------------------------------
/dist/
/out-tsc/
/tmp/
.angular/cache/18.2.21/SIGEWEBFE

# ---------------------------------------------
# TypeScript
# ---------------------------------------------
*.tsbuildinfo

# ---------------------------------------------
# JavaScript / map files / typings
# ---------------------------------------------
*.js
*.js.map
*.d.ts

# ---------------------------------------------
# Logs
# ---------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---------------------------------------------
# Coverage reports
# ---------------------------------------------
/coverage/

# ---------------------------------------------
# IDE / Editor files
# ---------------------------------------------
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# JetBrains IDEs (WebStorm, IntelliJ, Rider)
.idea/
*.iml

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# ---------------------------------------------
# System files
# ---------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------
# Temporary / backup files
# ---------------------------------------------
*.bak
*.old
*.orig
*.tmp
*.temp

# ---------------------------------------------
# Angular Material / Angular assets
# ---------------------------------------------
# Material prebuilt themes (si los importas desde node_modules, no subir)
node_modules/@angular/material/prebuilt-themes/
# Icon fonts (Material Icons, Roboto)
node_modules/roboto-fontface/
node_modules/material-design-icons/

# ---------------------------------------------
# Optional: compiled libraries
# ---------------------------------------------
/wwwroot/lib/
*.dll
*.so
*.dylib
*.a
*.lib
*.nupkg

# ---------------------------------------------
# Optional: ONNX Runtime native frameworks
# ---------------------------------------------
**/onnxruntime.framework/
**/onnxruntime.xcframework/

# ---------------------------------------------
# Angular CLI / Misc
# ---------------------------------------------
/publish/
out/
